# Run scripts/configure.py to generate local secrets and demo credentials.
DEMO_MODE=true
DEMO_PASSWORD=
JWT_SECRET_KEY=
# Leave DATABASE_URL unset for an absolute backend/horizon.db SQLite path.
# DATABASE_URL=postgresql+psycopg://horizon:YOUR_PASSWORD@localhost:5432/horizon
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Public Open-Meteo weather adapter does not need a key.
WEATHER_API_KEY=
# Optional live AIS HTTPS gateway, documented in docs/API.md.
AIS_URL=
AIS_API_KEY=
